{
  "name": "field-collections",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:api": "node scripts/smoke-api.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/db-check.ts",
    "demo:accounts": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/demo-accounts.ts",
    "import:check": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/import-check.ts",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/seed/main.ts",
    "icons": "node scripts/gen-icons.mjs",
    "assign:check": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/assign-check.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dexie": "^4.4.7",
    "drizzle-orm": "~0.45.4",
    "hono": "~4.13.16",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "~6.2.1",
    "drizzle-kit": "~0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "~17.14.0",
    "prettier": "~3.9.10",
    "simple-git-hooks": "~2.14.0",
    "tsx": "~4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vite-plugin-pwa": "~1.3.0",
    "vitest": "~5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "gitleaks protect --staged --redact"
  }
}
